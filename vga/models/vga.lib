* Educational, explicitly assumed CMOS Level-1 model; no foundry process claim.
* Includes illustrative capacitance and flicker-noise parameters, not PDK data.
.model VNM NMOS(LEVEL=1 VTO=.4 KP=200u LAMBDA=.02 GAMMA=.4 PHI=.7 TOX=15n CGSO=.2n CGDO=.2n CJ=.3m CJSW=.2n KF={KFL} AF=1)
.model VPM PMOS(LEVEL=1 VTO=-.4 KP=80u LAMBDA=.02 GAMMA=.4 PHI=.7 TOX=15n CGSO=.2n CGDO=.2n CJ=.3m CJSW=.2n KF={KFL} AF=1)
.subckt AMP IP IM OUT VDD VSS params: CC=.3p BIAS=1
IREF VDD BN {20u*BIAS}
M9 BN BN VSS VSS VNM W=20u L=1u AD=10p AS=10p PD=41u PS=41u
M8 BP BN VSS VSS VNM W=20u L=1u AD=10p AS=10p PD=41u PS=41u
M10 BP BP VDD VDD VPM W=40u L=1u AD=20p AS=20p PD=81u PS=81u
M5 TAIL BN VSS VSS VNM W=100u L=1u AD=50p AS=50p PD=201u PS=201u
M1 ND IM TAIL VSS VNM W=100u L=1u AD=50p AS=50p PD=201u PS=201u
M2 N1 IP TAIL VSS VNM W=100u L=1u AD=50p AS=50p PD=201u PS=201u
M3 ND ND VDD VDD VPM W=100u L=1u AD=50p AS=50p PD=201u PS=201u
M4 N1 ND VDD VDD VPM W=100u L=1u AD=50p AS=50p PD=201u PS=201u
M6 OUT N1 VSS VSS VNM W=160u L=1u AD=80p AS=80p PD=321u PS=321u
M7 OUT BP VDD VDD VPM W=400u L=1u AD=200p AS=200p PD=801u PS=801u
CM N1 OUT {CC}
.ends AMP
.subckt VGA VIN OUT CTRL CP REF VDD VSS params: CC=.3p BIAS=1 RIN=10k SCALE=1 G1=4 G2=8 CL=1p
RS VIN ATT {RIN}
MN ATT CTRL REF VSS VNM W={25u*SCALE} L=1u AD={12.5p*SCALE} AS={12.5p*SCALE} PD={51u*SCALE} PS={51u*SCALE}
MP ATT CP REF VDD VPM W={62.5u*SCALE} L=1u AD={31.25p*SCALE} AS={31.25p*SCALE} PD={126u*SCALE} PS={126u*SCALE}
X1 ATT FB1 MID VDD VSS AMP CC={CC} BIAS={BIAS}
RF1 MID FB1 {(G1-1)*2k}
RG1 FB1 REF 2k
X2 MID FB2 OUT VDD VSS AMP CC={CC} BIAS={BIAS}
RF2 OUT FB2 {(G2-1)*2k}
RG2 FB2 REF 2k
CLOAD OUT VSS {CL}
.ends VGA
